{
  "name": "learning-projects",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "esp",
  "runArgs": [
    "--device-cgroup-rule=c 188:* rmw",
    "--device-cgroup-rule=c 166:* rmw"
  ],
  "mounts": [
    "source=learning-projects-cargo-registry,target=/home/esp/.cargo/registry,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
