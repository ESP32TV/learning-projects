{
  "container": "devcontainer",
  "env": {
    "APP": "hello_world",
    "CHIP": "esp32c3",
    "RUST_TARGET": "riscv32imc-esp-espidf"
  },
  "cache": {
    "paths": [".embuild"],
    "key_files": ["Cargo.lock"]
  },
  "version": {
    "files": [
      {
        "path": "Cargo.toml",
        "pattern": "^version = \"([0-9]+\\.[0-9]+\\.[0-9]+)\"$"
      },
      {
        "path": "sdkconfig.defaults",
        "pattern": "^CONFIG_APP_PROJECT_VER=\"([0-9]+\\.[0-9]+\\.[0-9]+)\"$"
      }
    ]
  },
  "artifacts": ["hello_world-esp32c3.bin"],
  "emulator": {
    "chip": "esp32c3",
    "exit_on": "Hello, world!"
  }
}
